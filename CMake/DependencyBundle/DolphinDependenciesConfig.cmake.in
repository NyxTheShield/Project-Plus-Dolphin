@PACKAGE_INIT@

# Refuse an incompatible SDK rather than quietly changing the linked runtime.
if(NOT CMAKE_SYSTEM_NAME STREQUAL "@CMAKE_SYSTEM_NAME@" OR
   NOT CMAKE_CXX_COMPILER_ID STREQUAL "@CMAKE_CXX_COMPILER_ID@" OR
   NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL "@CMAKE_CXX_COMPILER_VERSION@" OR
   NOT CMAKE_SIZEOF_VOID_P EQUAL @CMAKE_SIZEOF_VOID_P@)
  message(FATAL_ERROR "Dolphin dependency bundle does not match this platform/compiler")
endif()
set(_bundle_arch "@CMAKE_SYSTEM_PROCESSOR@")
set(_consumer_arch "${CMAKE_SYSTEM_PROCESSOR}")
foreach(_variable _bundle_arch _consumer_arch)
  string(TOLOWER "${${_variable}}" ${_variable})
  string(REPLACE amd64 x86_64 ${_variable} "${${_variable}}")
  string(REPLACE aarch64 arm64 ${_variable} "${${_variable}}")
endforeach()
if(NOT _bundle_arch STREQUAL _consumer_arch)
  message(FATAL_ERROR "Dolphin dependency bundle has the wrong CPU architecture")
endif()
if(APPLE AND NOT CMAKE_OSX_DEPLOYMENT_TARGET VERSION_EQUAL "@CMAKE_OSX_DEPLOYMENT_TARGET@")
  message(FATAL_ERROR "Dolphin dependency bundle has a different macOS deployment target")
endif()
if(CMAKE_CONFIGURATION_TYPES)
  if(NOT CMAKE_CONFIGURATION_TYPES STREQUAL "Release")
    message(FATAL_ERROR "Prebuilt dependencies require -DCMAKE_CONFIGURATION_TYPES=Release")
  endif()
elseif(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
  message(FATAL_ERROR "Prebuilt dependencies require -DCMAKE_BUILD_TYPE=Release")
endif()

include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/DolphinDependenciesTargets.cmake")
add_library(LibUSB::LibUSB INTERFACE IMPORTED)
set_target_properties(LibUSB::LibUSB PROPERTIES
  INTERFACE_LINK_LIBRARIES usb
  INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include")
# SDL's installed config also runs FindLibUSB. Keep it pointed at the bundled
# library even on Windows, where there is no system libusb package.
get_target_property(LibUSB_LIBRARY usb IMPORTED_LOCATION_RELEASE)
set(LibUSB_INCLUDE_PATH "${PACKAGE_PREFIX_DIR}/include")
set(LibUSB_FOUND TRUE)
foreach(library mbedcrypto mbedx509 mbedtls)
  add_library(MbedTLS::${library} ALIAS ${library})
endforeach()

find_dependency(fmt CONFIG PATHS "${CMAKE_CURRENT_LIST_DIR}/../fmt" NO_DEFAULT_PATH)
find_dependency(glslang CONFIG PATHS "${CMAKE_CURRENT_LIST_DIR}/../glslang" NO_DEFAULT_PATH)
find_dependency(SDL3 CONFIG COMPONENTS SDL3-static
  PATHS "${CMAKE_CURRENT_LIST_DIR}/../SDL3" NO_DEFAULT_PATH)
set(DOLPHIN_PREBUILT_LIBRARIES FMT glslang LibUSB SDL3 SFML MBEDTLS)
